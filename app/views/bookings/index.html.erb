<div class="min-h-screen">

  <div class="flex justify-between items-center mb-6">
    <h1 class="text-3xl font-bold text-sky-800">
      予約一覧
    </h1>
  </div>

  <div class="bg-white rounded-lg shadow overflow-hidden">
    <table class="min-w-full">
      <thead class="bg-sky-600 text-white">
        <tr>
          <th class="px-6 py-3 text-left">
            予約番号
          </th>

          <th class="px-6 py-3 text-left">
            航路
          </th>

          <th class="px-6 py-3 text-left">
            船社
          </th>

          <th class="px-6 py-3 text-left">
            出港日
          </th>

          <th class="px-6 py-3 text-left"> 
            種別
          </th>

          <th class="px-6 py-3 text-left"> 
            本数
          </th>

          <th class="px-6 py-3 text-left"> 
            予約日
          </th>

          <th></th>
        </tr>
      </thead>

      <tbody class="divide-y divide-gray-200">
        <% @bookings.each do |booking| %>

          <tr class="hover:bg-sky-50">

            <td class="px-6 py-3">
              <%= booking.booking_number %>
            </td>

            <td class="px-6 py-3">
              <%= booking.voyage.route.departure_port.name %>
              →
              <%= booking.voyage.route.arrival_port.name %>
            </td>

            <td class="px-6 py-3">
              <%= booking.voyage.carrier.name %>
            </td>

            <td class="px-6 py-3">
              <%= booking.voyage.departure_date %>
            </td>

            <td class="px-6 py-3">
              <%= booking.container_type_i18n %>
            </td>

            <td class="px-6 py-3">
              <%= booking.quantity %>
            </td>

            <td class="px-6 py-3">
              <%= l booking.created_at.to_date %>
            </td>

            <td class="px-6 py-3">

              <div class="flex items-center gap-2">
                <%= link_to "詳細", 
                    booking_path(booking), 
                    class: "inline-block px-3 py-1 bg-sky-600 text-white rounded hover:bg-sky-700 transition" %>

                <%= button_to "削除",
                    booking_path(booking),
                    method: :delete,
                    data: {
                      turbo_confirm: "削除しますか？"
                    },
                    class: "px-3 py-1 bg-red-500 text-white rounded" %>
              </div>

            </td>

          </tr>

        <% end %>
      </tbody>
    </table>
  </div>

  <div class="mt-6">
    <%= link_to ports_path,
        class: "inline-flex items-center px-3 py-2 bg-gray-200 rounded hover:bg-gray-300 transition" do %>

      <svg xmlns="http://www.w3.org/2000/svg"
          fill="none"
          viewBox="0 0 24 24"
          stroke-width="1.5"
          stroke="currentColor"
          class="w-5 h-5">
        <path stroke-linecap="round"
              stroke-linejoin="round"
              d="M15.75 19.5 8.25 12l7.5-7.5" />
      </svg>

      <span>港一覧へ戻る</span>

    <% end %>
  </div>

</div>