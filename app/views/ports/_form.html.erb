<%= simple_form_for port do |f| %>

  <!-- 名前 -->
  <div class="mt-4">
    <%= f.input :name,
        label: "名前",
        input_html: { class: "block w-full rounded-md border-gray-300 shadow-sm p-2"} %>

    <%= f.input :map_x,
        label: "x軸",
        input_html: { class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm p-2" } %>

    <%= f.input :map_y,
        label: "y軸",
        input_html: { class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm p-2" } %>
    </div>

  </div>

  <!-- ボタン -->
  <%= f.button :submit,
      (port.persisted? ? "更新する" : "登録する"),
      class: "w-full bg-blue-600 text-white py-2 rounded-lg hover:bg-blue-700 transition mt-4" %>

<% end %>
