<div class="min-h-screen flex flex-col">
  <h1 class="font-bold text-2xl">港一覧</h1>

  <div class="w-full flex justify-center">
    <div class="relative w-full max-w-[900px]">
      <%= image_tag "map.svg", class: "w-full" %>

      <% @ports.each do |port| %>

        <%= link_to port_path(port),
            class: "absolute block",
            style: "
              left: #{port.map_x}%;
              top: #{port.map_y}%;
            " do %>

          <div
            class="absolute font-bold whitespace-nowrap"
            style="transform: translate(-50%, -50%);"
          >
            <%= port.name %>
          </div>

        <% end %>

      <% end %>
    </div>
  </div>
</div>
