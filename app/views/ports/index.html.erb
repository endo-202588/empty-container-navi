<div class="min-h-screen flex flex-col bg-sky-100 p-8">
  <h1 class="font-bold text-2xl">港一覧</h1>

  <div class="w-full flex justify-center">
    <div class="relative w-[900px]">
      <%= image_tag "map.svg", class: "w-full" %>

      <% @ports.each do |port| %>
        <%= link_to port_path(port),
            class: "absolute",
            style: "left: #{port.map_x}%; top: #{port.map_y}%;" do %>

          <span class="text-ms">
            ● <%= port.name %>
          </span>

        <% end %>
      <% end %>
    </div>
  </div>
</div>
