<div class="max-w-md mx-auto">

  <h1 class="text-xl font-bold mb-6">メールアドレス変更</h1>

  <%= simple_form_for current_user,
      url: email_path,
      html: { class: "space-y-5" } do |f| %>

    <!-- メールアドレス -->
    <%= f.input :email,
        label: "新しいメールアドレス",
        input_html: {
          class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm p-2 bg-white"
        } %>

    <!-- パスワード確認（おすすめ） -->
    <div>
      <%= label_tag :current_password, "現在のパスワード",
          class: "block text-sm font-medium text-gray-700 mb-1" %>

      <%= password_field_tag :current_password,
          nil,
          class: "mt-1 block w-full rounded-md border border-gray-300 shadow-sm p-2 bg-white" %>
    </div>

    <!-- ボタン -->
    <%= f.button :submit, "変更する",
        class: "w-full bg-blue-500 text-white py-2 rounded hover:bg-blue-600" %>

  <% end %>

</div>