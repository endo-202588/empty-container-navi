<div class="container mx-auto px-4">

  <div class="max-w-6xl mx-auto mt-10 bg-white p-8 rounded-xl shadow">

    <h1 class="text-center text-2xl font-bold">
      港の編集
    </h1>

    <div class="mt-6">
      <%= render "form", port: @port %>
    </div>

    <div class="mt-8">
      <%= link_to admin_ports_path,
          class: "inline-flex items-center px-3 py-2 bg-gray-200 rounded hover:bg-gray-300 transition" do %>

        <svg xmlns="http://www.w3.org/2000/svg"
                fill="none"
                viewBox="0 0 24 24"
                stroke-width="1.5"
                stroke="currentColor"
                class="w-5 h-5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5 8.25 12l7.5-7.5" />
            </svg>

            <span>港管理へ戻る</span>
      <% end %>
    </div>

  </div>

</div>
