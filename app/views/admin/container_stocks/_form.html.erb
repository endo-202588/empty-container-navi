<%= simple_form_for [:admin, container_stock] do |f| %>

  <%= f.association :port,
      collection: Port.where(country: "JP").order(:name),
      label: "港" %>

  <%= f.association :carrier,
      label: "船社" %>

  <%= f.input :container_type,
      as: :select,
      collection: ContainerStock.container_types_i18n.invert,
      label: "種別" %>

  <%= f.input :quantity,
      label: "在庫数" %>

  <%= f.button :submit,
      (container_stock.persisted? ? "更新する" : "登録する"),
      class: "w-full bg-blue-600 text-white py-2 rounded-lg hover:bg-blue-700 transition mt-4" %>

<% end %>