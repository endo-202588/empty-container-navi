<div class="min-h-screen p-8">
  <div class="flex justify-between items-center mb-6">
    <h1 class="text-3xl font-bold text-sky-800">
      在庫管理
    </h1>

    <%= link_to "＋ 新規在庫登録",
        new_admin_container_stock_path,
        class: "inline-block px-4 py-2 bg-green-600 text-white rounded hover:bg-green-700 transition" %>
  </div>

  <div class="bg-white rounded-lg shadow overflow-hidden">
    <table class="min-w-full">
      <thead class="bg-sky-600 text-white">
        <tr>
          <th class="px-6 py-3 text-left">港</th>
          <th class="px-6 py-3 text-left">船社</th>
          <th class="px-6 py-3 text-left">種別</th>
          <th class="px-6 py-3 text-right">在庫数</th>
          <th class="px-6 py-3 text-center">操作</th>
        </tr>
      </thead>

      <tbody class="divide-y divide-gray-200">
        <% @container_stocks.each do |stock| %>
          <tr class="hover:bg-sky-50">
            <td class="px-6 py-3">
              <%= stock.port.name %>
            </td>

            <td class="px-6 py-3">
              <%= stock.carrier.name %>
            </td>

            <td class="px-6 py-3">
              <%= stock.container_type_i18n %>
            </td>

            <td class="px-6 py-3 text-right font-semibold">
              <%= stock.quantity %>
            </td>

            <td class="px-6 py-3 text-center">
              <%= link_to "編集", edit_admin_container_stock_path(stock),
                  class: "inline-block px-3 py-1 bg-gray-500 text-white rounded hover:bg-gray-600 transition" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <div class="mt-6">
    <%= link_to admin_root_path,
        class: "inline-flex items-center px-3 py-2 bg-gray-200 rounded hover:bg-gray-300 transition" do %>

      <svg xmlns="http://www.w3.org/2000/svg"
                fill="none"
                viewBox="0 0 24 24"
                stroke-width="1.5"
                stroke="currentColor"
                class="w-5 h-5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5 8.25 12l7.5-7.5" />
            </svg>

            <span>管理画面へ戻る</span>
    <% end %>
  </div>
</div>