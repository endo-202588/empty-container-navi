<div class="min-h-screen bg-sky-100 p-8">
  <div class="max-w-5xl mx-auto bg-white rounded-lg shadow p-8">

    <h1 class="text-3xl font-bold text-sky-800 mb-8">
      在庫編集
    </h1>

    <%= render "form", container_stock: @container_stock %>

    <div class="mt-8">
      <%= link_to admin_container_stocks_path,
          class: "inline-flex items-center px-3 py-2 bg-gray-200 rounded hover:bg-gray-300 transition" do %>

        <svg xmlns="http://www.w3.org/2000/svg"
                fill="none"
                viewBox="0 0 24 24"
                stroke-width="1.5"
                stroke="currentColor"
                class="w-5 h-5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5 8.25 12l7.5-7.5" />
            </svg>

            <span>港管理へ戻る</span>
      <% end %>
    </div>

  </div>
</div>