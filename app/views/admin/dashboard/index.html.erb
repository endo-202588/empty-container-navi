<div class="min-h-screen">
  <h1 class="text-3xl font-bold text-sky-800 mb-8">
    管理画面
  </h1>

  <div class="grid gap-6 md:grid-cols-2 xl:grid-cols-3">
    <%= link_to admin_ports_path,
        class: "block bg-white rounded-lg shadow p-6 hover:bg-sky-50 transition" do %>

      <h2 class="text-xl font-semibold text-sky-700">
        港管理
      </h2>

      <p class="text-gray-600 mt-2">
        港の名称や地図上の座標を編集します
      </p>

    <% end %>

    <%= link_to admin_container_stocks_path,
        class: "block bg-white rounded-lg shadow p-6 hover:bg-sky-50 transition" do %>

      <h2 class="text-xl font-semibold text-sky-700">
        空コンテナ在庫管理
      </h2>

      <p class="text-gray-600 mt-2">
        港ごとの空コンテナ在庫を管理します
      </p>

    <% end %>

    <%= link_to admin_routes_path,
        class: "block bg-white rounded-lg shadow p-6 hover:bg-sky-50 transition" do %>

      <h2 class="text-xl font-semibold text-sky-700">
        航路管理
      </h2>

      <p class="text-gray-600 mt-2">
        航路を管理します
      </p>

    <% end %>

    <%= link_to admin_voyages_path,
        class: "block bg-white rounded-lg shadow p-6 hover:bg-sky-50 transition" do %>

      <h2 class="text-xl font-semibold text-sky-700">
        便管理
      </h2>

      <p class="text-gray-600 mt-2">
        便を管理します
      </p>

    <% end %>

    <%= link_to admin_bookings_path,
        class: "block bg-white rounded-lg shadow p-6 hover:bg-sky-50 transition" do %>

      <h2 class="text-xl font-semibold text-sky-700">
        予約管理
      </h2>

      <p class="text-gray-600 mt-2">
        予約を管理します
      </p>

    <% end %>
  </div>
</div>