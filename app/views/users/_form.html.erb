<%= simple_form_for user, url: url, method: (user.persisted? ? :patch : :post) do |f| %>
  <%= render "email_fields", f: f if @user.new_record? %>

  <%= render "password_fields", f: f if @user.new_record? %>

  <%= f.input :first_name %>
  <%= f.input :last_name %>

  <%= f.input :company_name %>

  <%= f.button :submit,
      (@user.persisted? ? "更新する" : "登録する") %>
<% end %>