<div class="min-h-screen flex flex-col items-center justify-center">
  <div class="bg-white p-10 rounded-xl shadow-md w-full max-w-md">

    <h1 class="text-3xl font-bold text-gray-800 text-center">
      ログイン
    </h1>

    <div class="mt-6">
      <%= simple_form_for @user,
            url: login_path,
            data: {
              turbo: false,
              controller: "password-toggle"
            } do |f| %>

        <%= f.input :email,
            input_html: {
              class: "mt-1 block w-full rounded-md border border-gray-300 px-3 py-2 shadow-sm",
              data: { password_toggle_target: "password" }
            } %>

        <%= f.input :password,
            required: true,
            input_html: {
              class: "mt-1 block w-full rounded-md border border-gray-300 px-3 py-2 shadow-sm",
              data: { password_toggle_target: "confirmation" }
            } %>

        <div class="mt-2">
          <label class="flex items-center gap-2 text-sm text-gray-600">
            <input type="checkbox"
                  data-action="password-toggle#toggle"
                  data-password-toggle-target="checkbox">
            パスワードを表示
          </label>
        </div>

        <%= f.button :submit,
            "ログイン",
            class: "mt-3 w-full bg-blue-600 text-white py-2 rounded-lg hover:bg-blue-700" %>

      <% end %>
    </div>

    <div class="mt-4 flex justify-center">
      <%= link_to "パスワードを忘れた方はこちら", new_password_reset_path,
          class: "flex items-center gap-2 text-pink-400 hover:text-pink-600 text-sm" %>

    </div>

  </div>

  <div class="mt-8">
    <%= link_to "トップへ戻る", root_path, class: "text-sm text-gray-600 hover:text-blue-600" %>
  </div>

</div>
