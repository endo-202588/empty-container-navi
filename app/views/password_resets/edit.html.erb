<div class="min-h-screen flex items-center justify-center px-4">
  <div class="bg-white/80 backdrop-blur-md rounded-2xl shadow-lg p-8 w-full max-w-md">

    <h1 class="text-2xl font-bold text-center text-gray-800 mb-6">
      新しいパスワード
    </h1>

    <%= simple_form_for @user,
          url: password_reset_path,
          method: :patch,
          html: {
            class: "space-y-4",
            data: { controller: "password-toggle" }
          } do |f| %>

      <%= hidden_field_tag :token, @token %>

      <!-- パスワード -->
      <%= f.input :password,
            label: "パスワード",
            input_html: {
              data: { password_toggle_target: "password" }
            } %>

      <!-- 確認用 -->
      <%= f.input :password_confirmation,
            label: "確認用パスワード",
            input_html: {
              data: { password_toggle_target: "confirmation" }
            } %>

      <!-- 表示切り替え -->
      <div class="mt-2">
        <label class="flex items-center gap-2 text-sm text-gray-600">
          <input type="checkbox"
                data-action="password-toggle#toggle"
                data-password-toggle-target="checkbox">
          パスワードを表示
        </label>
      </div>

      <!-- 送信 -->
      <%= f.button :submit, "更新する",
            class: "w-full bg-blue-400 hover:bg-blue-500 text-white font-semibold py-2 rounded-lg transition mt-3" %>

    <% end %>

  </div>
</div>