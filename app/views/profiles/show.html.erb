<div class="max-w-2xl mx-auto mt-10">

  <h1 class="text-2xl font-bold mb-6">
    <%= @user.full_name %> さんのプロフィール
  </h1>

  <div class="bg-white shadow rounded-xl p-6 space-y-4">

    <div>
      <p class="text-sm text-gray-500">会社名</p>
      <p class="text-lg">
        <%= @user.company_name %>
      </p>
    </div>

    <div>
      <p class="text-sm text-gray-500">名</p>
      <p class="text-lg">
        <%= @user.first_name %>
      </p>
    </div>

    <div>
      <p class="text-sm text-gray-500">姓</p>
      <p class="text-lg">
        <%= @user.last_name %>
      </p>
    </div>

    <div>
      <p class="text-sm text-gray-500">姓</p>
      <p class="text-lg">
        <%= @user.email %>
      </p>
    </div>
    
    <div class="flex gap-2 pt-4">
      <%= link_to "プロフィールを編集",
          edit_profile_path,
          class: "inline-block bg-blue-600 text-white px-4 py-2 rounded hover:bg-blue-700" %>

      <%= link_to "メールアドレスを変更する",
          edit_email_path,
          class: "inline-block bg-pink-600 text-white px-4 py-2 rounded hover:bg-pink-700" %>
    </div>

  </div>
</div>